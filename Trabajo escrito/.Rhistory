filter(Anyo >= 2016 & Anyo <= 2022 ) # Filtrar datos entre el 2016 y el 2022
library(WDI)
library(tidyverse)
library(knitr)
library(kableExtra)
datos <- WDI(
country = c("CRI", "DEU", "BOL"), # Costa Rica, Alemania y Bolivia
indicator = c( "SI.POV.GINI", "SL.UEM.TOTL.NE.ZS", "SE.XPD.TOTL.GD.ZS")
)
datos.limpios <- datos |>
rename("Pais" = "country",
"Anyo" = "year",
"Gini" = "SI.POV.GINI",
"Desempleo" = "SL.UEM.TOTL.NE.ZS",
"Educacion" = "SE.XPD.TOTL.GD.ZS") |>
select(-iso2c,-iso3c) |>
filter(Anyo >= 2016 & Anyo <= 2022 ) # Filtrar datos entre el 2016 y el 2022
datos.limpios |>
kable(
format = "latex",
booktabs = TRUE,
digits = 2,
na = "-", # Cambia los NA por guiones
col.names = c("País", "Año", "Gini", "Desempleo (%)", "Educación (% del PIB)"),
align = c("l", "c", "c", "c", "c")
) |>
kable_styling(latex_options = c("striped", "hold_position"), full_width = FALSE) |>
footnote(
general_title = "Fuente: ",
general = "Elaboración propia con datos del Banco Mundial (2026).",
footnote_as_chunk = TRUE
)
